                    if (wifiManager != null) {
                        wifiApConfig = wifiManager.getClass()
                                .getMethod("getWifiApConfiguration", new Class[0])
                                .invoke(wifiManager, new Object[0]);
                    }
                } catch (Throwable th) {
                    wifiApConfig = null;
                }
                if (wifiApConfig != null) {
                    // 3.1) SSID 字段（去除首尾引号）
                    try {
                        Object ssidField = wifiApConfig.getClass()
                                .getField("SSID").get(wifiApConfig);
                        String ssid = ssidField instanceof String ? (String) ssidField : null;
                        ssidRef[0] = ssid != null ? trimQuotes(ssid) : "";
                    } catch (Throwable th) {
                        ssidRef[0] = "";
                    }
                    // 3.2) preSharedKey 字段
                    try {
                        Object pskField = wifiApConfig.getClass()
                                .getField("preSharedKey").get(wifiApConfig);
                        pwdRef[0] = pskField instanceof String ? (String) pskField : null;
                    } catch (Throwable th) {
                        pwdRef[0] = null;
                    }
                }
            }
            // 4) 反射读取 wifi.interface 系统属性（AP 自身网卡名）
            String iface = "";
            try {
                Object ifaceResult = Class.forName("android.os.SystemProperties")
                        .getMethod("get", String.class, String.class)
                        .invoke(null, "wifi.interface", "");
                if (ifaceResult instanceof String) {
                    String ifaceStr = (String) ifaceResult;
                    if (ifaceStr != null && !ifaceStr.trim().isEmpty()) {
                        iface = ifaceStr;
                    }
                }
            } catch (Throwable th) {
                iface = "";
            }
            // 5) 解析 /proc/net/arp 统计客户端（失败记 -1）
            int clients = -1;
            try {
                List<String> arpLines = Files.readAllLines(
                        new File("/proc/net/arp").toPath(), StandardCharsets.UTF_8);
                List<String> entries = arpLines.size() > 1
                        ? arpLines.subList(1, arpLines.size())
                        : new ArrayList<String>();
                int count = 0;
                for (String line : entries) {
                    String[] parts = line.trim().split("\\s+");
                    // 热点客户端 arp 条目接口与 AP 自身同为 wlan0，不能用 iface 排除(否则永远统计 0 台)
                    if (parts.length >= 6
                            && "0x2".equals(parts[3])
                            && (parts[5].startsWith("wlan")
                            || parts[5].startsWith("ap")
                            || parts[5].startsWith("swlan"))) {
                        count++;
                    }
                }
                clients = count;
            } catch (Throwable th) {
                clients = -1;
            }
            // 6) 按可用性拼装结果串
            StringBuilder sb = new StringBuilder();
            String ssid = ssidRef[0];
            String pwd = pwdRef[0];
            if (ssid != null && !ssid.trim().isEmpty()) {
                sb.append("SSID\uff1a").append(ssid);
            }
            if (pwd != null && !pwd.trim().isEmpty()) {
                if (sb.length() > 0) {
                    sb.append(" \u00b7 ");
                }
                sb.append("\u5bc6\u7801\uff1a").append(pwd);
            }
            if (clients >= 0) {
                if (sb.length() > 0) {
                    sb.append(" \u00b7 ");
                }
                sb.append("\u5df2\u8fde\u63a5 ").append(clients).append(" \u53f0");
            }
            String result = sb.toString();
            boolean hasPwd = pwd != null && !pwd.trim().isEmpty();
            Log.i(TAG, "readHotspotConnInfo: ssid='" + ssid + "' hasPwd=" + hasPwd
                    + " clients=" + clients + " resultLen=" + result.length());
            return result;
        } catch (Throwable th) {
            Log.w(TAG, "readHotspotConnInfo failed: " + th);
            return "";
        }
    }

    /** 去除字符串首尾的半角双引号（旧 API SSID 字段带引号）。 */
    private static String trimQuotes(String value) {
        String result = value;
        if (result.length() >= 2 && result.startsWith("\"") && result.endsWith("\"")) {
            result = result.substring(1, result.length() - 1);
        }
        return result;
    }

