                    setDisabledChannels(loadDisabledChannels());
                    return;
                }
                return;
            case 354393908:
                if (!key.equals("sys_status_hotspot")) {
                    return;
                }
                break;
            case 654604306:
                if (key.equals("sys_status_persistent")) {
                    setSystemStatusPersistent(prefs.getBoolean("sys_status_persistent", false));
                    return;
                }
                return;
            case 727965832:
                if (key.equals("compact_height_dp")) {
                    setCompactHeightDp(prefs.getInt("compact_height_dp", 34));
                    return;
                }
                return;
            case 748688342:
                if (key.equals("avoid_cutout")) {
                    setAvoidCutout(prefs.getBoolean("avoid_cutout", true));
                    return;
                }
                return;
            case 987906456:
                if (key.equals("island_accent_color")) {
                    setIslandAccentColor(prefs.getInt("island_accent_color", IslandConfig.DEFAULT_ACCENT_COLOR));
                    return;
                }
                return;
            case 1199700009:
                if (!key.equals("sys_status_screen_record")) {
                    return;
                }
                break;
            case 1537239422:
                if (key.equals("hide_ongoing")) {
                    setHideOngoing(prefs.getBoolean("hide_ongoing", true));
                    return;
                }
                return;
            case 1734805931:
                if (key.equals("expanded_duration_ms")) {
                    setExpandedDurationMs(prefs.getInt("expanded_duration_ms", 4000));
                    return;
                }
                return;
            case 1940163494:
                if (key.equals("sys_status_enabled")) {
                    setSystemStatusEnabled(prefs.getBoolean("sys_status_enabled", true));
                    return;
                }
                return;
            default:
                return;
        }
        setStatusFlags(loadStatusFlags());
    }

    public final void setAllAppsEnabled() {
        putString("disabled_apps", "");
    }

    public final void setAppEnabled(String pkg, boolean enabled) {
        Intrinsics.checkNotNullParameter(pkg, "pkg");
        Set mutableSet = CollectionsKt.toMutableSet(getDisabledApps());
        if (enabled) {
            mutableSet.remove(pkg);
        } else {
            mutableSet.add(pkg);
        }
        putString("disabled_apps", StringUtils.joinToString(mutableSet, ","));
    }

    public final void setAppsDisabled(Collection<String> pkgs) {
        Intrinsics.checkNotNullParameter(pkgs, "pkgs");
        if (pkgs.isEmpty()) {
            return;
        }
        Set mutableSet = CollectionsKt.toMutableSet(getDisabledApps());
        mutableSet.addAll(pkgs);
        putString("disabled_apps", StringUtils.joinToString(mutableSet, ","));
    }

    public final void setChannelEnabled(String pkg, String channelId, boolean enabled) {
        Intrinsics.checkNotNullParameter(pkg, "pkg");
        Intrinsics.checkNotNullParameter(channelId, "channelId");
        String str = pkg + ":" + channelId;
        Set mutableSet = CollectionsKt.toMutableSet(getDisabledChannels());
        if (enabled) {
            mutableSet.remove(str);
        } else {
            mutableSet.add(str);
        }
        putString("disabled_channels", StringUtils.joinToString(mutableSet, ","));
    }

